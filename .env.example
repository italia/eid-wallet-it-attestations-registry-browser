# Trust Anchor used by the nightly dump and by the in-browser refresh.
# pre  = https://pre.ta.wallet.ipzs.it
# prod = https://ta.wallet.ipzs.it
ITW_REGISTRY_ENV=pre
ITW_REGISTRY_BASE_URL=https://pre.ta.wallet.ipzs.it

# Optional: also dump OpenID Federation listing (can be large).
ITW_DUMP_FEDERATION=false

# Optional: also dump each issuer's OpenID4VCI metadata.
ITW_DUMP_ISSUER_METADATA=true
