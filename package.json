{
  "name": "eid-wallet-it-attestations-registry-browser",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "IT-Wallet Attestations Explorer and Demo: search the public registry, inspect metadata, and preview demo credentials.",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dump": "node scripts/dump-registry.mjs",
    "dump:pre": "node scripts/dump-registry.mjs --env pre --with-issuer-metadata",
    "dump:prod": "node scripts/dump-registry.mjs --env prod --with-issuer-metadata",
    "sync-cache": "node scripts/sync-cache-public.mjs",
    "prebuild": "node scripts/sync-cache-public.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js"
  },
  "dependencies": {
    "bootstrap-italia": "^2.16.2",
    "cytoscape": "^3.33.1",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/italia/eid-wallet-it-attestations-registry-browser.git"
  },
  "keywords": [
    "it-wallet",
    "eudi-wallet",
    "eidas",
    "credential-catalog",
    "openid4vci"
  ]
}
