{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SD-JWT MDL Schema",
  "description": "An object defining the structure of a SD-JWT Verifiable Credential MDL compliant with IT Wallet Specification v1.3.3",
  "type": "object",
  "required": [
    "iss",
    "sub",
    "iat",
    "exp",
    "issuing_authority",
    "issuing_country",
    "issuance_date",
    "date_of_expiry",
    "status",
    "cnf",
    "vct",
    "_sd",
    "_sd_alg",
    "given_name",
    "family_name",
    "birthdate",
    "place_of_birth",
    "document_iss_country",
    "document_iss_authority",
    "document_number",
    "picture",
    "driving_privileges",
    "un_distinguishing_sign"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "description": "URL string representing the Credential Issuer unique identifier",
      "format": "uri"
    },
    "sub": {
      "type": "string",
      "description": "Identifier of the subject of the SD-JWT",
      "pattern": "^[a-f0-9]{8}-?[a-f0-9]{4}-?4[a-f0-9]{3}-?[89ab][a-f0-9]{3}-?[a-f0-9]{12}\\z$"
    },
    "iat": {
      "type": "number",
      "description": "UNIX Timestamp with the time of JWT issuance, coded as NumericDate as indicated in RFC 7519"
    },
    "exp": {
      "type": "number",
      "description": "UNIX Timestamp with the expiry time of the JWT, coded as NumericDate as indicated in RFC 7519"
    },
    "nbf": {
      "type": "number",
      "description": "UNIX Timestamp with the start time of validity of the JWT, coded as NumericDate as indicated in RFC 7519"
    },
    "vct": {
      "type": "string",
      "description": "Credential type identifier (URN)."
    },
    "vct#integrity": {
      "type": "string",
      "description": "A String representing an integrity metadata for ensuring the integrity of the resource referred to by the vct"
    },
    "verification": {
      "type": "object",
      "required": ["trust_framework", "assurance_level"],
      "properties": {
        "trust_framework": {
          "type": "string",
          "enum": ["it_l2+document_proof", "it_cie", "it_wallet", "eudi_wallet"]
        },
        "assurance_level": {
          "type": "string",
          "enum": ["high", "substantial"]
        }
      },
      "additionalProperties": false
    },
    "issuing_authority": {
      "type": "string",
      "description": "Name of the administrative authority that has issued the SD-JWT VC",
      "pattern": "^(?!\\s)(?!.*\\s\\s)(?!.*\\s$).+$"
    },
    "issuing_country": {
      "type": "string",
      "description": "Country of the SD-JWT VC issuing authority, as a two letter country code defined in ISO 3166-1 alpha-2",
      "enum": ["IT"]
    },
    "issuance_date": {
      "type": "string",
      "format": "date",
      "description": "Administrative issuance date of the credential"
    },
    "date_of_expiry": {
      "type": "string",
      "format": "date",
      "description": "Administrative expiration date of the credential"
    },
    "status": {
      "type": "object",
      "required": ["status_list"],
      "properties": {
        "status_list": {
          "type": "object",
          "required": ["idx", "uri"],
          "properties": {
            "idx": {
              "type": "integer",
              "minimum": 0
            },
            "uri": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cnf": {
      "type": "object",
      "required": ["jwk"],
      "properties": {
        "jwk": {
          "type": "object",
          "required": ["kty", "crv", "x", "y"],
          "properties": {
            "alg": {
              "type": "string",
              "enum": ["ES256", "ES384", "ES512"]
            },
            "key_ops": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kid": {
              "type": "string"
            },
            "kty": {
              "type": "string",
              "enum": ["EC"]
            },
            "use": {
              "type": "string",
              "enum": ["sig", "enc"]
            },
            "x5c": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "x5t": {
              "type": "string"
            },
            "x5t#S256": {
              "type": "string"
            },
            "x5u": {
              "type": "string",
              "format": "uri"
            },
            "crv": {
              "type": "string",
              "enum": ["P-256", "P-384", "P-521"]
            },
            "x": {
              "type": "string"
            },
            "y": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "_sd": {
      "type": "array",
      "description": "Digests of the disclosures",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "_sd_alg": {
      "type": "string",
      "description": "Identifier of the hash algorithm used by the Credential Issuer to generate the digests",
      "enum": ["sha-256"]
    },
    "given_name": {
      "type": "string",
      "description": "First Name of the mDL holder"
    },
    "family_name": {
      "type": "string",
      "description": "Family Name of the mDL holder"
    },
    "birthdate": {
      "type": "string",
      "format": "date",
      "description": "Date of birth of the mDL holder"
    },
    "place_of_birth": {
      "type": "string",
      "description": "Place of birth of the mDL holder"
    },
    "document_iss_country": {
      "type": "string",
      "description": "Country of the mDL issuing authority, as a two letter country code defined in ISO 3166-1 alpha-2",
      "pattern": "^[A-Z]{2}$"
    },
    "document_iss_authority": {
      "type": "string",
      "description": "Name of the administrative authority that has issued the mDL"
    },
    "document_number": {
      "type": "string",
      "description": "mDL number"
    },
    "picture": {
      "type": "string",
      "description": "mDL holder’s picture in base64 encoded",
      "pattern": "^data:image\\/(png|jpeg);base64,(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "restrictions_conditions": {
      "type": "string",
      "description": "Restriction condition"
    },
    "driving_privileges": {
      "type": "array",
      "description": "Driving privileges of the mDL holder",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["vehicle_category_code"],
        "properties": {
          "vehicle_category_code": {
            "type": "string",
            "description": "Vehicle category code"
          },
          "issue_date": {
            "type": "string",
            "description": "Vehicle category issue date",
            "format": "date"
          },
          "expiry_date": {
            "type": "string",
            "description": "Vehicle category expiry date",
            "format": "date"
          },
          "codes": {
            "type": "array",
            "description": "Conditions and restrictions of the vehicle category code",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["code"],
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Condition/restriction code"
                },
                "sign": {
                  "type": "string",
                  "description": "Condition/restriction sign"
                },
                "value": {
                  "type": "string",
                  "description": "Condition/restriction value"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "un_distinguishing_sign": {
      "type": "string",
      "description": "Distinguishing sign of the mDL issuing country according to ISO/IEC 18013-1:2018, Annex F",
      "enum": ["I"]
    }
  },
  "additionalProperties": false
}
