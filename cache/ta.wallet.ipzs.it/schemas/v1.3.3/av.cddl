; Returned data elements signed by the issuer
IssuerSigned = {
    "nameSpaces" : IssuerNameSpacesObjectBytes, ; Data elements in Bytes
    "issuerAuth" : IssuerAuthObjectBytes ; Mobile security object (MSO) for issuer data authentication in Bytes
}

IssuerNameSpacesObjectBytes = {      
    "eu.europa.ec.av.1" : [
        #6.24(bstr .cbor Age_over_18)                                                                         
    ],
    "it.ipzs.wallet.ta.av.1" : [
        #6.24(bstr .cbor Sub),                       
        ? #6.24(bstr .cbor Verification),            
        #6.24(bstr .cbor Issuing_country),      
        #6.24(bstr .cbor Issuing_authority),    
    ]
}

; Digest and element identifiers
DigestID = uint
DataElementIdentifier = tstr
RandomValue = bstr

Age_over_18 = { digestID: DigestID, random: RandomValue, elementIdentifier: DataElementIdentifier .enum ("age_over_18"), elementValue: bool }

Issuing_country = { digestID: DigestID, random: RandomValue, elementIdentifier: DataElementIdentifier .enum ("issuing_country"), elementValue: tstr .regexp "^[A-Z]{2}$" }
Issuing_authority = { digestID: DigestID, random: RandomValue, elementIdentifier: DataElementIdentifier .enum ("issuing_authority"), elementValue: tstr } 

Sub = { digestID: DigestID, random: RandomValue, elementIdentifier: DataElementIdentifier .enum ("sub"), elementValue: tstr .regexp "^[a-f0-9]{8}-?[a-f0-9]{4}-?4[a-f0-9]{3}-?[89ab][a-f0-9]{3}-?[a-f0-9]{12}\\z$" }

Verification = { digestID: DigestID, random: RandomValue, elementIdentifier: DataElementIdentifier .enum ("verification"), elementValue: VerificationValue }
VerificationValue = {
    trust_framework: tstr .enum ("it_l2+document_proof", "it_cie", "it_wallet", "eudi_wallet"), 
    assurance_level: tstr .enum ("https://ta.wallet.ipzs.it/loa/high", "https://ta.wallet.ipzs.it/loa/substantial")
}


; Mobile Security Object
IssuerAuthObjectBytes = #6.18(COSE_Sign1)
COSE_Sign1 = [ Headers, payload: #6.24(bstr .cbor MobileSecurityObject), signature: bstr ]
Headers = ( protected: protected_header_map, unprotected: unprotected_header_map )
protected_header_map = { 1 => AlgorithmIdentifier }
unprotected_header_map = { 4 => bstr, 33 => bstr }

MobileSecurityObject = {
    "version" : tstr .enum ("1.0"),
    "digestAlgorithm" : tstr .enum ("SHA-256"),
    "valueDigests" : ValueDigests,
    "deviceKeyInfo" : DeviceKeyInfo,
    "docType" : tstr .enum ("eu.europa.ec.av.1"),
    "validityInfo" : ValidityInfo,
    ? "status" : Status
}
ValueDigests = { "eu.europa.ec.av.1": DigestIDs, "it.ipzs.wallet.ta.av.1": DigestIDs }
DigestIDs = [1* DigestID]

DeviceKeyInfo = { "deviceKey": COSE_Key, ? "keyInfo": KeyInfo, ? "keyAuthorizations": KeyAuthorizations }
COSE_Key = { 1=>tstr/int, ?2=>bstr, ?3=>AlgorithmIdentifier, ?4=>[+(tstr/int)], ?5=>bstr, *label=>values }
label = int/tstr
values = any
AlgorithmIdentifier = tstr .enum ("ES256","ES384","ES521")
KeyInfo = { * int => any }
KeyAuthorizations = { ? "nameSpaces": AuthorizedNameSpaces, ? "dataElements": AuthorizedDataElements }
AuthorizedNameSpaces = ["eu.europa.ec.av.1","it.ipzs.wallet.ta.av.1"]
AuthorizedDataElements = { "eu.europa.ec.av.1": DataElementsArray, "it.ipzs.wallet.ta.av.1": DataElementsArray }
DataElementsArray = [1* DataElementIdentifier]

ValidityInfo = { "signed": tdate, "validFrom": tdate, "validUntil": tdate, ? "expectedUpdate": tdate }
Status = { ? "status_list": StatusListInfo }
StatusListInfo = { "idx": uint, "uri": tstr }