; Returned data elements signed by the issuer
IssuerSigned = {
  "nameSpaces" : IssuerNameSpacesObjectBytes,
  ; Data elements in Bytes
  "issuerAuth" : IssuerAuthObjectBytes ; Mobile security object (MSO) for issuer data authentication in Bytes
}

IssuerNameSpacesObjectBytes = {
  "org.iso.18013.5.1" : [
    #6.24(bstr .cbor Given_name),
    #6.24(bstr .cbor Family_name),
    #6.24(bstr .cbor Birth_date),
    #6.24(bstr .cbor Birth_place),
    #6.24(bstr .cbor Issue_date),
    #6.24(bstr .cbor Issuing_country),
    #6.24(bstr .cbor Issuing_authority),
    #6.24(bstr .cbor Expiry_date),
    #6.24(bstr .cbor Document_number),
    #6.24(bstr .cbor Portrait),
    #6.24(bstr .cbor Driving_privileges),
    #6.24(bstr .cbor Un_distinguishing_sign)
  ],
  "org.iso.18013.5.1.IT" : [
    #6.24(bstr .cbor Sub),
    ? #6.24(bstr .cbor Verification),
    #6.24(bstr .cbor Document_iss_country),
    #6.24(bstr .cbor Document_iss_authority),
  ]
}

; Digest and element identifiers
DigestID = uint
DataElementIdentifier = tstr
RandomValue = bstr

; Common mDL elements
Family_name = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("family_name"),
  elementValue: tstr
}
Given_name = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("given_name"),
  elementValue: tstr
}
Birth_date = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("birth_date"),
  elementValue: tdate
}
Birth_place = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("birth_place"),
  elementValue: tstr
}
Issue_date = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("issue_date"),
  elementValue: tdate
}
Expiry_date = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("expiry_date"),
  elementValue: tdate
}
Document_number = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("document_number"),
  elementValue: tstr
}
Portrait = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("portrait"),
  elementValue: bstr
}
Driving_privileges = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("driving_privileges"),
  elementValue: [ 1* DrivingPrivilege ]
}
Un_distinguishing_sign = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("un_distinguishing_sign"),
  elementValue: tstr .enum ("I")
}

Document_iss_country = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("document_iss_country"),
  elementValue: tstr .regexp "^[A-Z] {
    2
  }
}
Document_iss_authority = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("document_iss_authority"),
  elementValue: tstr
}
Issuing_country = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("issuing_country"),
  elementValue: tstr .regexp "^[A-Z] {
    2
  }
}
Issuing_authority = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("issuing_authority"),
  elementValue: tstr
}

Sub = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("sub"),
  elementValue: tstr .regexp "^[a-f0-9] {
    8}-?[a-f0-9] {
      4}-?4[a-f0-9] {
        3
      }
    }
  }
}

Verification = {
  digestID: DigestID,
  random: RandomValue,
  elementIdentifier: DataElementIdentifier .enum ("verification"),
  elementValue: VerificationValue
}
VerificationValue = {
  trust_framework: tstr .enum ("it_l2+document_proof", "it_cie", "it_wallet", "eudi_wallet"),
  assurance_level: tstr .enum ("https://ta.wallet.ipzs.it/loa/high", "https://ta.wallet.ipzs.it/loa/substantial")
}

DrivingPrivilege = {
  vehicle_category_code: tstr,
  ? issue_date: tdate,
  ? expiry_date: tdate,
  ? codes: [ 1* Code ]
}
Code = {
  code: tstr,
  ? sign: tstr,
  ? value: tstr
}

; Mobile Security Object
IssuerAuthObjectBytes = #6.18(COSE_Sign1)
COSE_Sign1 = [ Headers, payload: #6.24(bstr .cbor MobileSecurityObject), signature: bstr ]
Headers = ( protected: protected_header_map, unprotected: unprotected_header_map )
protected_header_map = {
  1 => AlgorithmIdentifier
}
unprotected_header_map = {
  4 => bstr,
  33 => bstr
}

MobileSecurityObject = {
  "version" : tstr .enum ("1.0"),
  "digestAlgorithm" : tstr .enum ("SHA-256"),
  "valueDigests" : ValueDigests,
  "deviceKeyInfo" : DeviceKeyInfo,
  "docType" : tstr .enum ("org.iso.18013.5.1.mDL"),
  "validityInfo" : ValidityInfo,
  ? "status" : Status
}
ValueDigests = {
  "org.iso.18013.5.1": DigestIDs,
  "org.iso.18013.5.1.IT": DigestIDs
}
DigestIDs = [1* DigestID]

DeviceKeyInfo = {
  "deviceKey": COSE_Key,
  ? "keyInfo": KeyInfo,
  ? "keyAuthorizations": KeyAuthorizations
}
COSE_Key = {
  1=>tstr/int,
  ?2=>bstr,
  ?3=>AlgorithmIdentifier,
  ?4=>[+(tstr/int)],
  ?5=>bstr,
  *label=>values
}
label = int/tstr
values = any
AlgorithmIdentifier = tstr .enum ("ES256","ES384","ES521")
KeyInfo = {
  * int => any
}
KeyAuthorizations = {
  ? "nameSpaces": AuthorizedNameSpaces,
  ? "dataElements": AuthorizedDataElements
}
AuthorizedNameSpaces = ["org.iso.18013.5.1","org.iso.18013.5.1.IT"]
AuthorizedDataElements = {
  "org.iso.18013.5.1": DataElementsArray,
  "org.iso.18013.5.1.IT": DataElementsArray
}
DataElementsArray = [1* DataElementIdentifier]

ValidityInfo = {
  "signed": tdate,
  "validFrom": tdate,
  "validUntil": tdate,
  ? "expectedUpdate": tdate
}
Status = {
  ? "status_list": StatusListInfo
}
StatusListInfo = {
  "idx": uint,
  "uri": tstr
}